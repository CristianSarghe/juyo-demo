{
  "name": "juyo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/validate-sql-data.ts",
    "deploy": "wrangler deploy",
    "bundle:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "bundle:kassandra": "wrangler deploy --config wrangler.kassandra.jsonc --dry-run --outdir dist/kassandra",
    "test:worker": "tsx scripts/smoke-worker.ts",
    "test:mcp": "tsx scripts/smoke-mcp.ts"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "mssql": "12.7.14"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.0",
    "wrangler": "4.162.0",
    "esbuild": "0.28.2"
  }
}
