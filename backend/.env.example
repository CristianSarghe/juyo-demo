# Template only. Copy to an ignored .env and supply values through your shell.
SQL_SERVER=your-sql-server.example
SQL_DATABASE=your_database
SQL_USER=
SQL_PASSWORD=
SQL_PORT=1433
ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:4201,http://localhost:4201,https://juyo-demo.pages.dev,https://juyo-demo.cristiansarghe.com
KASSANDRA_URL=https://mcp-juyo.cristiansarghe.com

# Separate Kassandra Worker configuration. Keep real keys in Cloudflare secrets.
JUYO_API_URL=https://api-juyo.cristiansarghe.com/api/v1
MCP_PUBLIC_URL=https://mcp-juyo.cristiansarghe.com/mcp
OPENAI_API_KEY=

# Optional for authenticated CLI deployment; never commit the actual values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
