{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juyo-kassandra",
  "main": "src/kassandra-worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "keep_vars": true,
  "routes": [{ "pattern": "mcp-juyo.cristiansarghe.com", "custom_domain": true }],
  "vars": {
    "JUYO_API_URL": "https://api-juyo.cristiansarghe.com/api/v1",
    "MCP_PUBLIC_URL": "https://mcp-juyo.cristiansarghe.com/mcp",
    "ALLOWED_ORIGINS": "http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:4201,http://localhost:4201,https://juyo-demo.pages.dev,https://juyo-demo.cristiansarghe.com",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
